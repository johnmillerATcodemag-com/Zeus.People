<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="EPSPackages" value="https://pkgs.dev.azure.com/eps-software/_packaging/EPSPackages/nuget/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
            <package pattern="Azure.Extensions.*" />
            <package pattern="Azure.Identity" />
            <package pattern="Azure.Security.*" />
        </packageSource>
    </packageSourceMapping>
    <!-- Removed restrictive packageSourceMapping to avoid conflicts with user-level mapping causing NU1100 -->
</configuration>
